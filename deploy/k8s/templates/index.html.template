<!DOCTYPE html>
<html>
	<head>
		<title>ROBrowser</title>
		<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=0, viewport-fit=cover">
		<script type="text/javascript" src="applications/api/api.js"></script>
		<script type="text/javascript">
			function initialize() {
				var ROConfig = {
					target:        document.getElementById("robrowser"),
					type:          ROBrowser.TYPE.FRAME,
					application:   ROBrowser.APP.ONLINE,
					remoteClient:  "http://${HOST}:${PORT_HTTP}/client/",
					width:         '100%',
					height:        '100%',
					development:   true,
					loadLua:       true,
					servers: [{
						display:     "Demo Server",
						desc:        "roBrowser's demo server",
						address:     "ragnarok-login",
						port:        6900,
						version:     25,
						langtype:    12,
						packetver:   ${PACKETVER},
						packetKeys:  [
							${PACKET_OBFUSCATION_KEY1},
							${PACKET_OBFUSCATION_KEY2},
							${PACKET_OBFUSCATION_KEY3}
						],
						socketProxy: "ws://${WS_HOST}:${PORT_WSPROXY}/"
					}],
					skipServerList:  true,
					skipIntro:       true
				};
				var RO = new ROBrowser(ROConfig);
				RO.start();
			}
			window.addEventListener("load", initialize, false);
		</script>
		<style type="text/css">
			* { box-sizing: border-box; }
			body, #robrowser { min-height: 100vh; max-height: 100vh; }
			html, body { margin: 0; padding: 0; }
			iframe { width: 100%; height: 100vh; padding: 0; display: block; }
		</style>
	</head>
	<body>
		<div id="robrowser">Initializing roBrowser...</div>
	</body>
</html>
